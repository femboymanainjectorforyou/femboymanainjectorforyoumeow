local _OrF = {}
local function _Cl(n) 
    return n:gsub("^DFFlag",""):gsub("^FFlag",""):gsub("^DFInt",""):gsub("^FInt",""):gsub("^DFString",""):gsub("^FString","") 
end
local function _GF(n) 
    local s, v = pcall(function() return getfflag(n) end) 
    return s and v or nil 
end
local function _SF(n, v) 
    local s, e = pcall(function() return setfflag(n, tostring(v)) end) 
    return s, e 
end

_Ap.MouseButton1Click:Connect(function()
    local s, d = pcall(function() return _H:JSONDecode(_Tx.Text) end)
    if not s or type(d) ~= "table" then 
        _Ap.Text = "Ошибка JSON" 
        task.wait(1.5) 
        _Ap.Text = "Применить" 
        return 
    end
    
    local c = 0
    for k, v in pairs(d) do
        local fn = _Cl(k)
        local cv = _GF(fn)
        if cv ~= nil then
            if _OrF[fn] == nil then 
                _OrF[fn] = cv 
            end
            if _SF(fn, v) then 
                c = c + 1 
            end
        end
    end
    
    _Ap.Text = "Успешно: " .. tostring(c)
    task.wait(1.5)
    _Ap.Text = "Применить"
end)

_Un.MouseButton1Click:Connect(function()
    local c = 0
    for fn, ov in pairs(_OrF) do
        if _SF(fn, ov) then 
            c = c + 1 
        end
    end
